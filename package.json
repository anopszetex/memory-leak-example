{
  "name": "memory-leak-example",
  "version": "1.0.0",
  "description": "Practical Node.js memory leak diagnosis with a safe control endpoint",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:monitor": "CLIMEM=8999 node -r climem src/index.js",
    "climem": "npx climem 8999",
    "test": "node --test",
    "load:safe": "autocannon -c 100 -d 30 -p 10 http://localhost:3000/safe",
    "load:leak": "autocannon -c 100 -d 30 -p 10 http://localhost:3000/leak",
    "flame-0x": "npx 0x -- node src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anopszetex/memory-leak-example.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anopszetex/memory-leak-example/issues"
  },
  "homepage": "https://github.com/anopszetex/memory-leak-example#readme",
  "devDependencies": {
    "0x": "^5.2.1",
    "autocannon": "^7.8.1",
    "climem": "^1.0.3"
  }
}
